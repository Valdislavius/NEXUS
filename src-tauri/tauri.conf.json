{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS Desktop",
  "version": "0.3.1",
  "identifier": "local.nexus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NEXUS Desktop · Alpha 0.3.1",
        "width": 1280,
        "height": 900,
        "minWidth": 600,
        "minHeight": 540,
        "backgroundColor": "#0c0c0f",
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/nexus-collector"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../docs/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../docs/LICENSES.md": "LICENSES.md",
      "../docs/MPL-SOURCES/": "MPL-SOURCES/",
      "../docs/PawnIO/": "PawnIO/"
    }
  }
}
